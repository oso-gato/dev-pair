#!/usr/bin/env bash
# strix.env — the per-environment adapter for the strix pair.
#
# An addition beside erebus.env, never a fork of the tree (00-BYLAW.md, host
# tracks). Everything that differs between the two lineages is in this file and
# nowhere else, which is the whole test of whether the adapter rule held.
#
# Environment facts have their one home in the estate registry at
# homelab-root environments/strix.md, and this file carries only the subset the
# converger acts on. It is a declaration, so it holds no credential.
#
# Sourced, never executed.

# ── Identity of the pair ─────────────────────────────────────────────────────
PAIR_NAME=strix                      # the lineage, named by its host
PAIR_TRACK=baremetal                 # image rebase with atomic rollback
HOST_NAME=strix
DEV_CONTAINER_NAME=moros

# ── Which units apply on this track ──────────────────────────────────────────
# This is the load-bearing difference between the two lineages, and it follows
# from the bylaw rather than from convenience. The VPS track's sanctioned deploy
# mechanism IS the converger, so erebus runs every unit. The bare-metal track's
# is image rebase with atomic rollback: strix's OS state — the administrative
# user, the package set, the tailnet client, podman, the agent box — is baked
# into `oso-gato/strix-ms-s1-bootc` and arrives by rebase, so converging it here
# would be a second mechanism competing with the image for the same facts.
#
# What the image does not carry is the pair's second component and the estate's
# own pair-neutral App minter, so those two units run and no others. An empty or
# unset list means every unit, which is what erebus wants.
CONVERGE_UNITS="50-github-app 70-dev-container"

# ── GitHub App identities (registry: homelab-root identity/github-apps.md) ───
# NOT YET CREATED. The registry lists both as planned for when this pair rises,
# so the IDs are deliberately empty and the vault holds no PEM for either.
#
# This is a real prerequisite rather than an oversight, and it is the
# maintainer's to clear: creating a GitHub App is an act on github.com that no
# artifact here can perform. Until both exist, activation completes and the
# host joins the tailnet, but the boxes hold no GitHub authority and every unit
# that touches an App says so rather than reporting green. Fill in the two IDs
# below, put the PEMs in the vault under the names already declared, and re-run
# — which is what an idempotent apply is for.
HOST_APP_NAME=oso-gato-strix-claudebox
HOST_APP_ID=
HOST_APP_INSTALLATION_ID=
DEV_APP_NAME=oso-gato-moros-claudebox
DEV_APP_ID=
DEV_APP_INSTALLATION_ID=

# ── Trust root (C6) ──────────────────────────────────────────────────────────
TRUST_ROOT_USER=oso-gato
ADMIN_USER=core                      # the estate's administrative user (C7)

# ── Tailnet ──────────────────────────────────────────────────────────────────
# Unlike erebus, this host has a LAN behind it, so it advertises that route.
# The subnet is the registry's recorded LAN (gateway 10.0.50.1). Tailscale SSH
# gives a tailnet-identity-authenticated shell without widening the public
# surface, and LAN SSH and mosh keep flowing through OpenSSH on the image's own
# keys-only policy.
TAILNET_HOSTNAME=strix
TAILSCALE_ARGS=(--hostname=strix --advertise-routes=10.0.50.0/24 --ssh)

# ── The vault (C6; ADR 000011) ───────────────────────────────────────────────
# The core declaration is absent here on purpose. On the bare-metal track the
# administrative user, its keys and its sudo hash are baked from the trust root
# at image build, because declarations are records (00-BYLAW.md) — so
# activation has no password to set and never reads one.
VAULT_REPO=oso-gato/homelab-root
VAULT_TSKEY=identity/tskey-auth-oso-2026-09-26-expiry.key
VAULT_HOST_APP_KEY=identity/github-app-strix-claudebox.key.pem
VAULT_DEV_APP_KEY=identity/github-app-moros-claudebox.key.pem

# ── The dev-container image ──────────────────────────────────────────────────
# The same image erebus runs. One definition, two instances: what differs is
# the name above and the App identity, and both are facts rather than structure.
DEV_CONTAINER_IMAGE=ghcr.io/oso-gato/dev-container:44

# ── Where the converger installs ─────────────────────────────────────────────
# /usr is READ-ONLY on a bootc host: the image owns it and it changes only by
# rebase. Writing there would fail, and succeeding would be worse — it would be
# the mutable out-of-band change C7 forbids. These are the writable paths a
# bootc system provides for exactly this: /usr/local resolves to /var/usrlocal,
# and /etc/systemd/system is local administrative configuration.
BIN_DIR=/usr/local/bin
UNIT_DIR=/etc/systemd/system

# ── Where durable state lives ────────────────────────────────────────────────
# The image mounts the data drive at /var/home, so the administrative user's
# home is there rather than under /home. That is the one path difference
# between the tracks, and it is why these are declared per environment.
PAIR_STATE_DIR=/var/lib/dev-pair
PAIR_SECRETS_DIR=/var/lib/dev-pair/secrets
ADMIN_HOME=/var/home/core
PAIR_ADMIN_STATE=/var/home/core/.dev-pair
PAIR_DEV_SECRETS_DIR=/var/home/core/.dev-pair/secrets
PAIR_WORK_DIR=/var/home/core/dev-pair/work
