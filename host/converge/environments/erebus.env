#!/usr/bin/env bash
# erebus.env — the per-environment adapter for the erebus pair.
#
# Onboarding a new environment is an adapter addition and never a fork
# (00-BYLAW.md, host tracks): a second host adds its own file beside this one
# and changes nothing else. Only what genuinely differs between hosts lives
# here; anything true of every host belongs in the units.
#
# Environment facts have their one home in the estate registry at
# homelab-root environments/erebus.md, and this file carries only the subset
# the converger acts on. It is a declaration, so it holds no credential.
#
# Sourced, never executed.

# ── Identity of the pair ─────────────────────────────────────────────────────
PAIR_NAME=erebus                     # the lineage, named by its host
PAIR_TRACK=vps                       # VPS track: converger, no virt, no GPU
HOST_NAME=erebus
DEV_CONTAINER_NAME=nox

# ── GitHub App identities (registry: homelab-root identity/github-apps.md) ───
# IDs are records, not secrets (C6). The private keys stay in the vault and
# reach the host only at run time, through day zero.
HOST_APP_NAME=oso-gato-erebus-claudebox
HOST_APP_ID=4179928
HOST_APP_INSTALLATION_ID=143450113
DEV_APP_NAME=oso-gato-nox-claudebox
DEV_APP_ID=4238728
DEV_APP_INSTALLATION_ID=145009272

# ── Trust root (C6) ──────────────────────────────────────────────────────────
# The maintainer's published key set is the single trust root, consumed live.
TRUST_ROOT_USER=oso-gato
ADMIN_USER=core                      # the estate's administrative user (C7)

# ── Tailnet ──────────────────────────────────────────────────────────────────
# No --advertise-routes on this track: erebus is a cloud host with no LAN
# behind it, so it joins as a plain node. Tailscale SSH is on, giving a
# tailnet-identity-authenticated shell without widening the public surface.
TAILNET_HOSTNAME=erebus
TAILSCALE_ARGS=(--hostname=erebus --ssh)

# ── The vault (C6; ADR 000011) ───────────────────────────────────────────────
# The one private repository where live credentials rest. Day zero reads these
# paths after its single device-flow authorization, and nothing else does.
VAULT_REPO=oso-gato/homelab-root
VAULT_CORE_DECLARATION=identity/core-user.md
VAULT_TSKEY=identity/tskey-auth-oso-2026-09-26-expiry.key
VAULT_HOST_APP_KEY=identity/github-app-erebus-claudebox.key.pem
VAULT_DEV_APP_KEY=identity/github-app-nox-claudebox.key.pem

# ── The dev-container image ──────────────────────────────────────────────────
# One image serves every lineage; the instance name above is what differs.
# CI builds and publishes it, and the host pulls it — neither component builds
# production images. Pinned to the Fedora generation the host runs, never
# :latest, which would rebase to the next Fedora silently at release.
DEV_CONTAINER_IMAGE=ghcr.io/oso-gato/dev-container:44

# ── Where the converger installs ─────────────────────────────────────────────
# The converger owns this host's OS state on this track, so it installs into
# the ordinary system paths.
BIN_DIR=/usr/bin
UNIT_DIR=/usr/lib/systemd/system

# ── Where durable state lives ────────────────────────────────────────────────
# Nothing durable lives in a layer (C8). These are the host paths that survive
# every box rebuild and every dev-container relaunch.
#
# The split is by owner, and it is deliberate. The host component's own App key
# is root-owned and unreadable to anyone else; everything the dev-container and
# the sessions touch is owned by the administrative user, because the
# dev-container runs rootless as that user and cannot read root's secrets,
# which is C6's least
# privilege expressed as file ownership rather than as a policy document.
PAIR_STATE_DIR=/var/lib/dev-pair
PAIR_SECRETS_DIR=/var/lib/dev-pair/secrets
ADMIN_HOME=/home/core
PAIR_ADMIN_STATE=/home/core/.dev-pair
PAIR_DEV_SECRETS_DIR=/home/core/.dev-pair/secrets
PAIR_WORK_DIR=/home/core/dev-pair/work
