#!/usr/bin/env bash
# nox — enter the dev-container.
#
# Sessions are multi-tenant and each is isolated by scope, so this attaches to
# a NAMED tmux session rather than a shared shell: `nox` alone attaches to the
# default session, `nox <name>` to that one, creating it if it does not exist.
# The session lives inside the container and its work lives on the durable
# volume, so a dropped connection loses neither.
set -uo pipefail

CONTAINER="${DEV_CONTAINER_NAME:-nox}"
SESSION="${1:-main}"

if ! podman container exists "$CONTAINER" 2>/dev/null; then
    echo "nox: container '$CONTAINER' does not exist — the host has not launched it yet." >&2
    echo "     start it with: systemctl --user start $CONTAINER" >&2
    exit 1
fi

state=$(podman inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo unknown)
if [ "$state" != "running" ]; then
    echo "nox: container '$CONTAINER' is $state — starting it…" >&2
    systemctl --user start "$CONTAINER" || {
        echo "nox: could not start '$CONTAINER' — inspect: journalctl --user -u $CONTAINER" >&2
        exit 1
    }
fi

# -A creates the session when it is absent and attaches when it is present, so
# one command covers both the first connection and every reconnection after a
# roam, a sleep, or a client restart.
exec podman exec -it "$CONTAINER" tmux new-session -A -s "$SESSION"
