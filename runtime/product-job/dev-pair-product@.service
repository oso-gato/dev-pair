[Unit]
Description=Dev-pair protected product job %i
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=root
UMask=0077
ExecStart=/usr/bin/python3 -EBs /usr/libexec/dev-pair/tools/product_job.py work %i
Restart=on-failure
RestartPreventExitStatus=2 76
RestartSec=10s
RuntimeMaxSec=1500s
TimeoutStopSec=15s
MemoryMax=768M
TasksMax=256
CPUQuota=100%
