[Unit]
Description=Reconcile the bounded checklist candidate transfer
RequiresMountsFor=/var/lib/dev-pair/checklist-validation
After=local-fs.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -EBs /usr/libexec/dev-pair/tools/checklist_candidate.py sweep-spool
TimeoutStartSec=30s
MemoryMax=160M
TasksMax=32
