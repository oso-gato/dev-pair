[Unit]
Description=Collect and independently verify a queued dev-pair agent candidate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -EBs /usr/libexec/dev-pair-observer/tools/agent_observer_station.py
TimeoutStartSec=49min
TimeoutStopSec=15s
KillMode=control-group
