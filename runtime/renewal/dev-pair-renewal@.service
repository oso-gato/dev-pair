[Unit]
Description=Reconcile an approved dev-pair %i renewal
After=local-fs.target network-online.target dev-pair-renewal-recovery.service
Wants=network-online.target
RequiresMountsFor=/var/lib/dev-pair
StartLimitIntervalSec=6min
StartLimitBurst=5

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/libexec/dev-pair/tools/renewal.py reconcile %i --check-candidate
TimeoutStartSec=110min
TimeoutStopSec=30s
KillMode=control-group
Restart=on-failure
RestartSec=30s
RestartPreventExitStatus=2
