[Unit]
Description=Verify the approved current upstream stable dev-pair agent offer
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/dev-pair

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/libexec/dev-pair/renewal/agent-candidate
TimeoutStartSec=300s
TimeoutStopSec=15s
KillMode=control-group
