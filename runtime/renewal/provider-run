#!/usr/bin/python3 -I
"""Run the existing broker for exactly one already authorized protected operation."""
import os
from pathlib import Path
import stat
import sys

INSTALL = Path('/usr/libexec/dev-pair')
sys.path.insert(0, str(INSTALL / 'tools'))
import renewal as r
from renewal import protocol as p

ROOT = r.DEFAULT_ROOT
CONTROL = ROOT / 'renewal'
CREDENTIALS = Path('/etc/dev-pair/provider-credentials')
CHANNELS = Path('/run/dev-pair/provider')


def root_directory(path, mode=0o700):
    try:
        path.mkdir(mode=mode)
        path.chmod(mode)
    except FileExistsError:
        pass
    node = path.lstat()
    r.require(path.resolve(strict=True) == path and stat.S_ISDIR(node.st_mode) and node.st_uid == 0 and
              stat.S_IMODE(node.st_mode) == mode, 'unsafe broker directory')


def launch(sha):
    from provider_billing import require_broker_release
    from provider_transition import Fence

    r.digest(sha)
    Fence().require_ready()
    spec = r.read_json(CONTROL / 'broker-requests' / (sha + '.json'))
    p.fields(spec, 'role job operation credential_ref host_artifact_sha256')
    role, job, operation = (spec[key] for key in ('role', 'job', 'operation'))
    account = r.pwd.getpwnam({'maintenance': 'dp-maint', 'development': 'dp-dev'}[role])
    for value in (job, operation, spec['credential_ref']):
        r.token(value)
    r.digest(spec['host_artifact_sha256'])
    release = INSTALL / 'host-releases' / spec['host_artifact_sha256']
    selected = r.read_json(CONTROL / 'host-selection.json')
    r.require(selected['artifact_sha256'] == release.name and release.resolve(strict=True) == release and
              release.stat().st_uid == 0 and not release.stat().st_mode & 0o222, 'unverified broker control plane')
    require_broker_release(INSTALL / 'tools', release / 'tools')
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(release / 'tools'))
    from provider_broker import grant_document, protected_file
    grant_path = CONTROL / 'provider-grants' / (sha + '.json')
    grant = grant_document(protected_file(grant_path, 8192))
    r.require(grant['request_sha256'] == sha and (grant['peer_uid'], grant['peer_gid']) == (account.pw_uid, account.pw_gid),
              'provider authorization does not match the role operation')
    request = ROOT / 'turn-inputs' / role / job / operation / 'turn' / 'request.json'
    r.require(r.sha(protected_file(request, 4096)) == sha, 'protected broker request digest changed')
    secret = CREDENTIALS / spec['credential_ref']
    # Provider code reads the actual credential only after root admission.
    info = secret.lstat()
    r.require(secret.resolve(strict=True) == secret and stat.S_ISREG(info.st_mode) and
              info.st_uid == 0 and stat.S_IMODE(info.st_mode) == 0o600, 'operator provider credential unavailable')
    root_directory(CHANNELS, 0o711)
    socket_dir = CHANNELS / sha[:32]
    source = ROOT / role / 'state' / job
    state = source.lstat()
    r.require(source.resolve(strict=True) == source and stat.S_ISDIR(state.st_mode) and state.st_uid == account.pw_uid,
              'broker requires the admitted role state leaf')
    label = os.getxattr(source, 'security.selinux')
    if os.path.lexists(socket_dir):
        node = socket_dir.lstat()
        r.require(stat.S_ISDIR(node.st_mode) and (node.st_uid, node.st_gid) == (0, account.pw_gid) and
                  stat.S_IMODE(node.st_mode) == 0o750 and not any(socket_dir.iterdir()) and
                  os.getxattr(socket_dir, 'security.selinux') == label, 'prior provider channel cannot be safely reused')
    else:
        socket_dir.mkdir(mode=0o700)
        os.chown(socket_dir, 0, account.pw_gid)
        os.setxattr(socket_dir, 'security.selinux', label)
        socket_dir.chmod(0o750)
    evidence = ROOT / 'provider-evidence'
    for path in (evidence, evidence / role, evidence / role / job):
        root_directory(path)
    script = release / 'tools' / 'provider_broker.py'
    command = ['/usr/bin/python3', '-I', '-B', str(script), '--grant', str(grant_path), '--request', str(request),
               '--credential-file', str(secret), '--socket', str(socket_dir / 'responses.sock'),
               '--receipt', str(evidence / role / job / (operation + '.json'))]
    Fence().require_ready()
    os.execve(command[0], command, {'PATH': '/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'})


if __name__ == '__main__':
    r.require(os.getuid() == 0 and len(sys.argv) == 2, 'protected operation provider required')
    launch(sys.argv[1])
