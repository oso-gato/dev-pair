#!/usr/bin/env bash
# pair-session — PID 1 of the dev-container, whichever lineage it serves.
#
# The container's whole purpose is that sessions outlive the client that
# started them, so PID 1 is a supervisor rather than a shell: it holds the
# container up, keeps the GitHub App token fresh, and lets sessions come and go
# underneath it. A dropped connection reaches no further than the tmux client.
#
# Sessions attach with `podman exec ... tmux new-session -A -s <name>`, which is
# what the host's enter command does. Multi-tenancy is by named session, and
# isolation is by scope rather than by identity — no session reads or touches
# another's work, because each is entered against its own declared repository
# set under /work.
set -uo pipefail

TOKEN_REFRESH_SECONDS=${TOKEN_REFRESH_SECONDS:-3000}   # ~50 min; tokens live ~1 h

log() { printf '[%s] %s\n' "${DEV_CONTAINER_NAME:-dev-container}" "$*"; }

# Durable work lives on the mounted volume, so this is the one directory that
# has to exist before anything else runs.
mkdir -p /work "$HOME/.local/state/claudebox" 2>/dev/null || true

# ── The GitHub App token ─────────────────────────────────────────────────────
# This component mints its OWN token from its OWN App — the one that carries
# merge permission, which the host's does not. No-ops cleanly when the App is
# not mounted, leaving a container with no GitHub authority rather than a
# broken one.
mint() {
    if [ -f "${PAIR_APP_DIR:-/run/secrets/github-app}/private-key.pem" ]; then
        if /usr/bin/pair-gh-app-token >/dev/null 2>&1; then
            log "GitHub App token minted"
        else
            log "GitHub App token mint failed — retrying at the next tick"
        fi
    fi
}

mint
(
    while :; do
        sleep "$TOKEN_REFRESH_SECONDS"
        mint
    done
) &
refresher=$!

# ── The tmux server ──────────────────────────────────────────────────────────
# Start it up front so the first `podman exec` attach is instant and so a
# session's death never takes the server, and the container, down with it.
tmux start-server 2>/dev/null || log "tmux server did not start; sessions will start it on demand"

shutdown() {
    log "shutting down"
    kill "$refresher" 2>/dev/null || true
    tmux kill-server 2>/dev/null || true
    exit 0
}
trap shutdown TERM INT

log "ready — attach with: ${DEV_CONTAINER_NAME:-the dev-container} [session-name]"

# Hold the container up. `wait` rather than `sleep infinity` so the trap fires
# promptly on the stop signal instead of after a timeout.
while :; do
    wait "$refresher" 2>/dev/null || true
    sleep 5
done
