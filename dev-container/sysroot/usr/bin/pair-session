#!/usr/bin/env bash
# pair-session — PID 1 of the dev-container.
#
# The container's whole purpose is that sessions outlive the client that
# started them, so PID 1 is a supervisor rather than a shell: it opens this
# component's own public door, keeps the GitHub App token fresh, and lets
# sessions come and go underneath it.
#
# This component has its own door rather than sitting behind the host's. The
# objective's Security outcome 1 names hardened SSH/MOSH on BOTH components of
# every pair as the only public doors, so reaching this container by way of the
# host would leave one of the two the objective requires unbuilt.
#
# Multi-tenancy is by named tmux session, and isolation is by scope rather than
# by identity — no session reads or touches another's work, because each is
# entered against its own declared repository set under /work.
set -uo pipefail

TOKEN_REFRESH_SECONDS=${TOKEN_REFRESH_SECONDS:-3000}   # ~50 min; tokens live ~1 h
KEYS_REFRESH_SECONDS=${KEYS_REFRESH_SECONDS:-86400}    # daily, like the host's timer
KEYDIR=/etc/ssh/keys

log() { printf '[%s] %s\n' "${DEV_CONTAINER_NAME:-dev-container}" "$*"; }

mkdir -p /work "$KEYDIR" /run/dev-pair /run/tailscale /var/lib/tailscale 2>/dev/null || true

# ── Nested user namespaces for the agent box (docs/decisions/000029) ─────────
# Build-time setcap does not survive every podman storage configuration: the
# security.capability xattr can be lost on a layer commit. Verify and restore
# at boot, or the first `distrobox assemble` dies with "newuidmap: write to
# uid_map failed: Operation not permitted" and the failure reads as a podman
# bug rather than a missing capability. Idempotent — a no-op when already set.
for bin in /usr/bin/newuidmap /usr/bin/newgidmap; do
    [ -x "$bin" ] || continue
    if ! getcap "$bin" 2>/dev/null | grep -q cap_set; then
        case "$bin" in
            */newuidmap) setcap cap_setuid+ep "$bin" && log "restored capabilities on $bin" ;;
            */newgidmap) setcap cap_setgid+ep "$bin" && log "restored capabilities on $bin" ;;
        esac
    fi
done

# ── The public door ──────────────────────────────────────────────────────────
# Host keys live on a mounted volume rather than in the image. An image-baked
# key would be identical on every pair running this image — the shared-credential
# case C6 forbids — and a key regenerated per start would trip every client's
# host-key check on each relaunch, training you to type "yes" to a changed key.
for type in ed25519 rsa; do
    if [ ! -s "$KEYDIR/ssh_host_${type}_key" ]; then
        ssh-keygen -q -t "$type" -N '' -f "$KEYDIR/ssh_host_${type}_key" \
            && log "generated a persistent ${type} host key"
    fi
done
chmod 0600 "$KEYDIR"/ssh_host_*_key 2>/dev/null || true

# Who may come through it. The maintainer's published key set is the single
# trust root (C6); rotating a key there closes this door too, on the next tick.
sync_keys() {
    if runuser -u core -- env "TRUST_ROOT_USER=${TRUST_ROOT_USER:-oso-gato}" \
            /usr/bin/pair-keys-sync >/dev/null 2>&1; then
        log "authorized_keys synced from the trust root"
    else
        log "trust-root sync did not complete; existing keys left untouched"
    fi
}
sync_keys

if [ ! -s /var/home/core/.ssh/authorized_keys ] && [ ! -s /home/core/.ssh/authorized_keys ]; then
    log "WARNING: no authorized key for core — the public door will refuse every login"
fi

if /usr/sbin/sshd -t 2>/dev/null; then
    /usr/sbin/sshd -D -e &
    sshd_pid=$!
    log "sshd listening on 22 (published by the host); mosh bootstraps over it and inherits keys-only"
else
    sshd_pid=""
    log "ERROR: sshd configuration does not parse — no public door on this component"
    /usr/sbin/sshd -t
fi

# ── The tailnet ──────────────────────────────────────────────────────────────
# This component is its own tailnet node with its own Tailscale SSH door, not a
# service reachable only behind the host's (docs/decisions/000030). Two doors,
# two identities: the tailnet ACL can grant reach to the dev-container without
# granting reach to the host that operates it.
#
# State persists on a mounted volume, so a relaunch rejoins as the same node
# rather than burning a fresh machine entry on every restart.
if command -v tailscaled >/dev/null 2>&1; then
    tailscaled --state=/var/lib/tailscale/tailscaled.state \
               --socket=/run/tailscale/tailscaled.sock >/dev/null 2>&1 &
    tailscaled_pid=$!
    sleep 2

    if tailscale --socket=/run/tailscale/tailscaled.sock status >/dev/null 2>&1; then
        log "already joined the tailnet as ${TAILNET_HOSTNAME:-$HOSTNAME}"
    elif [ -r "${PAIR_TSKEY_PATH:-/run/secrets/tailscale/authkey}" ]; then
        # The key reaches tailscale as a path rather than as a value.
        # /proc/<pid>/cmdline is world-readable regardless of who owns the
        # process, so `--authkey="$(cat …)"` published a live tailnet auth key
        # to every account in this container for the length of the join. The
        # `file:` prefix is tailscale's own form for this and has been stable
        # since 1.38; we use tailscale's own canonical spelling rather than the
        # legacy `--authkey` alias, so no flag rewriting is relied on. The key file is already mounted
        # read-only, so nothing new lands on disk. The substitution form also
        # depended, silently, on `$(…)` stripping the file's trailing newline —
        # tailscale trims the file's contents itself, so the dependency goes.
        if tailscale --socket=/run/tailscale/tailscaled.sock up \
                --hostname="${TAILNET_HOSTNAME:-$HOSTNAME}" --ssh \
                --auth-key="file:${PAIR_TSKEY_PATH:-/run/secrets/tailscale/authkey}" >/dev/null 2>&1; then
            log "joined the tailnet as ${TAILNET_HOSTNAME:-$HOSTNAME}, Tailscale SSH on"
        else
            log "tailnet join failed — the auth key may be expired; reachable on the public door meanwhile"
        fi
    else
        log "no tailnet auth key mounted — this component is reachable on its public door only"
    fi
else
    tailscaled_pid=""
    log "tailscaled absent from this image — no tailnet door on this component"
fi

# ── The GitHub App token ─────────────────────────────────────────────────────
# This component mints its OWN token from its OWN App — the one that carries
# merge permission, which the host's does not. No-ops cleanly when the App is
# not mounted, leaving a container with no GitHub authority rather than a
# broken one.
mint() {
    if [ -f "${PAIR_APP_DIR:-/run/secrets/github-app}/private-key.pem" ]; then
        if /usr/bin/pair-gh-app-token >/dev/null 2>&1; then
            log "GitHub App token minted"
        else
            log "GitHub App token mint failed — retrying at the next tick"
        fi
    fi
}
mint

(
    elapsed=0
    while :; do
        sleep "$TOKEN_REFRESH_SECONDS"
        mint
        elapsed=$((elapsed + TOKEN_REFRESH_SECONDS))
        if [ "$elapsed" -ge "$KEYS_REFRESH_SECONDS" ]; then
            sync_keys
            elapsed=0
        fi
    done
) &
refresher=$!

# ── The tmux server ──────────────────────────────────────────────────────────
# Start it up front so the first login attaches instantly and so one session's
# death never takes the server, and the container, down with it.
runuser -u core -- tmux start-server 2>/dev/null \
    || log "tmux server did not start; sessions will start it on demand"

shutdown() {
    log "shutting down"
    kill "$refresher" 2>/dev/null || true
    [ -n "$sshd_pid" ] && kill "$sshd_pid" 2>/dev/null
    [ -n "$tailscaled_pid" ] && kill "$tailscaled_pid" 2>/dev/null
    runuser -u core -- tmux kill-server 2>/dev/null || true
    exit 0
}
trap shutdown TERM INT

log "ready — ssh/mosh to this component directly on its published ports, over the tailnet, or attach from the host"

# Hold the container up. `wait` rather than a sleep loop so the trap fires
# promptly on the stop signal instead of after a timeout.
while :; do
    wait -n 2>/dev/null || true
    sleep 5
done
