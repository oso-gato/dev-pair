#!/usr/bin/env bash
# dp-validate — validate a JSON instance against a vendored bus grammar (P7).
# The contracts' ONE home is shared/contracts/ in the repository; the image vendors them
# at /usr/local/share/devpair/contracts/ (same change, never hand-copied — P9).
# Consumers fail-safe refuse: an unknown grammar, version, or field never gets posted
# to the bus.
#
# Usage: dp-validate <grammar> <instance.json>
#   <grammar> is one of: ticket-envelope, verdict, refresh-manifest, lineage-manifest
#   (or a path to a schema file, for tests)
set -uo pipefail

CONTRACTS="${DP_CONTRACTS_DIR:-/usr/local/share/devpair/contracts}"
grammar="${1:-}"; instance="${2:-}"
[ -n "$grammar" ] && [ -n "$instance" ] || { echo "usage: dp-validate <grammar> <instance.json>" >&2; exit 2; }
[ -f "$instance" ] || { echo "dp-validate: instance '$instance' not found" >&2; exit 2; }

case "$grammar" in
    /*|*.json) schema="$grammar" ;;
    *)         schema="$CONTRACTS/$grammar.v1.schema.json" ;;
esac
[ -f "$schema" ] || { echo "dp-validate: no schema for grammar '$grammar' (looked for $schema) — refusing" >&2; exit 1; }

python3 - "$schema" "$instance" <<'PY'
import sys
import jsonschema
schema = jsonschema.Draft202012Validator
with open(sys.argv[1]) as f:
    s = __import__("json").load(f)
with open(sys.argv[2]) as f:
    i = __import__("json").load(f)
errors = list(schema(s).iter_errors(i))
if errors:
    for e in errors:
        print(f"dp-validate: REFUSED — {e.message}", file=sys.stderr)
    sys.exit(1)
print(f"dp-validate: {sys.argv[2]} conforms to {sys.argv[1].split('/')[-1]}")
PY
