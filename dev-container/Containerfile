# dev-pair — the DEV-CONTAINER image (FR-WORK-1..3; highly stable by design: it changes
# only through this repository's merge-and-deploy path).
#
# Base: Fedora 44. Provenance (P1): Fedora repos (L1) + Tailscale's own dnf repo (L2)
# whose .repo file is pinned BY SHA256 here and bumped here only, after a live re-check
# (P2). Last live re-check 2026-08-03 (content unchanged since the fleet's pin).
# Re-pin with:
#   curl -fsSL https://pkgs.tailscale.com/stable/fedora/tailscale.repo | sha256sum
ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

ARG TAILSCALE_REPO_SHA256=87206259fb7032fb4147eabccf4ffdb0b4d850d0519ef4c6991cf8c4d100ac13

COPY dev-container/install.sh /tmp/install.sh
RUN TAILSCALE_REPO_SHA256="$TAILSCALE_REPO_SHA256" bash /tmp/install.sh && rm /tmp/install.sh

COPY --chmod=755 dev-container/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=755 dev-container/bin/ /usr/local/bin/

# The bus grammars, vendored from their ONE home (P9 — same repository, same change).
# dp-bus validates every verdict it posts against these; nothing is hand-copied.
COPY shared/contracts/ /usr/local/share/devpair/contracts/

ENV LANG=en_US.UTF-8

# Durable state lives OUTSIDE the image (P11): core's home (work, credentials,
# transcripts) and the state volume (ssh host keys, tailscale identity).
VOLUME ["/home/core", "/var/lib/devpair"]
# EXPOSE is metadata only; the authoritative published ports live in
# dev-container.container (public ssh + mosh, key-only — FR-SEC-1/2).
EXPOSE 22 61001-62000/udp
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
