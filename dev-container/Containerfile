# ─────────────────────────────────────────────────────────────────────────────
# Containerfile — the pair's dev-container. One image, every lineage.
#
# Built by CI and never by a component: neither the host nor the container
# builds production images (00-OBJECTIVE.md, Boundaries). CI publishes to
# ghcr.io/oso-gato/dev-container and the host pulls what CI published, so the image is
# the artifact and the running container is disposable (C7).
#
# What this component is, per the objective: it develops and validates at
# tier 1, it is home to the multi-tenant sessions, and it is the platform's
# sole merge authority under its empirical gates. The host refreshes it from
# outside, and it never rebuilds itself (B4).
#
# Base pinned to :44, never :latest — :latest would rebase to the next Fedora
# silently at release, which is exactly the mutable out-of-band change C7
# forbids.
#
# Layering discipline (B1): heavy and stable layers early, churning layers
# late, so iterative rebuilds ride the layer cache.
# ─────────────────────────────────────────────────────────────────────────────
FROM quay.io/fedora/fedora:44

# ─── PINNED VENDOR ASSET: Tailscale's own repository definition ──────────────
# This component joins the tailnet as its own node, so it needs the client.
# The definition is the VENDOR'S file, pinned by checksum and verified
# fail-closed — a changed upstream stops the build instead of silently
# redefining where packages come from. The pin lives here and is bumped here
# only, after a live re-check (C5):
#   curl -fsSL https://pkgs.tailscale.com/stable/fedora/tailscale.repo | sha256sum
ARG TAILSCALE_REPO_URL=https://pkgs.tailscale.com/stable/fedora/tailscale.repo
ARG TAILSCALE_REPO_SHA256=87206259fb7032fb4147eabccf4ffdb0b4d850d0519ef4c6991cf8c4d100ac13
RUN set -eu; \
    curl -fsSL --proto '=https' --tlsv1.2 "$TAILSCALE_REPO_URL" -o /tmp/tailscale.repo; \
    echo "${TAILSCALE_REPO_SHA256}  /tmp/tailscale.repo" | sha256sum -c - \
      || { echo "tailscale.repo checksum mismatch — re-verify upstream and re-pin (C5)"; exit 1; }; \
    install -m 0644 /tmp/tailscale.repo /etc/yum.repos.d/tailscale.repo; \
    rm -f /tmp/tailscale.repo

# ─── Packages ────────────────────────────────────────────────────────────────
# L1 throughout, install_weak_deps=False per the bylaw's minimalism flag, and
# the most specific leaf package rather than any convenience metapackage (C3).
# Each group carries the justification C3 requires:
#   git, gh            the ticket bus is the durable hand-off, and this
#                      component is the one that merges
#   tmux               sessions survive disconnection because the session
#                      lives here, not in the client
#   openssh-server,    this component's own public door. The objective names
#   mosh               hardened SSH/MOSH on BOTH components of every pair as
#                      the only public doors, so reaching this container by way
#                      of the host would leave one of the two unbuilt. mosh
#                      bootstraps itself over that same sshd, so it inherits
#                      the keys-only policy rather than adding a second one.
#   curl               the trust-root key sync fetches over https
#   tailscale          this component is its own tailnet node with its own
#                      Tailscale SSH door, not a service behind the host's
#                      (docs/decisions/000030). L2, vendor definition pinned
#                      by checksum above.
#   libcap             setcap/getcap for the newuidmap capabilities the nested
#                      agent box depends on (docs/decisions/000029)
#   podman, distrobox  this component runs its own claudebox (C8: an agent
#                      present on the dev-container is present on its host)
#   python3            the App-token minter parses JSON
#   openssl            the same minter signs the App JWT with it
#   shadow-utils       subordinate id ranges for the in-container rootless user
#   ca-certificates    every fetch above is https and fails closed without it
#   procps-ng, less,   the irreducible working set of an interactive session
#   findutils, diffutils, tar, gzip, which
RUN dnf -y --setopt=install_weak_deps=False install \
        git gh tmux \
        openssh-server mosh curl \
        tailscale \
        podman distrobox \
        python3 openssl \
        shadow-utils ca-certificates libcap \
        procps-ng less findutils diffutils tar gzip which \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf*

# ─── The shared surfaces (C8) ────────────────────────────────────────────────
# The same box manifest and the same App-token minter the host uses. They are
# in shared/ precisely because both components use them, and copying them here
# rather than forking them is what keeps that true.
COPY shared/claudebox/ /usr/share/dev-pair/claudebox/
COPY shared/bin/       /usr/bin/
COPY shared/profile.d/  /etc/profile.d/

# ─── The component's own sysroot ─────────────────────────────────────────────
# Copied wholesale, so a file added under dev-container/sysroot/ arrives in the
# image by being written and needs no line here. That is how this component's
# init, its sshd policy and its tmux geometry policy all land.
COPY dev-container/sysroot/ /

# The box commands live in shared/ but belong on PATH, so they are linked
# rather than copied — one home, reachable from where it is used (C1).
RUN chmod 0755 /usr/share/dev-pair/claudebox/claudebox-init.sh \
               /usr/share/dev-pair/claudebox/claude \
               /usr/share/dev-pair/claudebox/claudebox-rebuild \
               /usr/share/dev-pair/claudebox/claudebox-daily \
               /usr/bin/pair-gh-app-token \
               /usr/bin/pair-keys-sync \
               /usr/bin/pair-session \
    && ln -sf /usr/share/dev-pair/claudebox/claude            /usr/local/bin/claude \
    && ln -sf /usr/share/dev-pair/claudebox/claudebox-rebuild /usr/local/bin/claudebox-rebuild \
    && ln -sf /usr/share/dev-pair/claudebox/claudebox-daily   /usr/local/bin/claudebox-daily

# ─── The session user ────────────────────────────────────────────────────────
# Sessions do not run as root. `core` is the estate's administrative identity
# on every host it operates (C7), and carrying the same name into the
# dev-container keeps one name for one thing (C1). Logins land as `core`; the
# container's own init runs as root so sshd can accept them and drop.
#
# That root is not privilege: this container is launched rootless, so container
# root maps to the unprivileged host user that owns it. Least privilege is held
# by the user namespace rather than by refusing an in-container uid (C6).
RUN useradd --create-home --shell /bin/bash core \
    && install -d -m 0755 -o core -g core /work \
    && install -d -m 0700 /etc/ssh/keys \
    && printf 'core:10000:55000\n' > /etc/subuid \
    && printf 'core:10000:55000\n' > /etc/subgid

# ─── Nested user namespaces for the agent box (docs/decisions/000029) ────────
# The subordinate ranges above are sized to fit INSIDE the outer rootless map,
# not to the usual host-side defaults: core=1000 plus 10000..64999 stays under
# 65536. A range that overflows the outer map cannot be written at all, and the
# first box assemble fails.
#
# shadow-utils' RPM scriptlet sets these file capabilities, but the
# security.capability xattr does not reliably survive layer commits in every
# podman storage configuration. Without them, nested userns setup fails with
# "newuidmap: write to uid_map failed: Operation not permitted". Set explicitly
# here, and verified again at boot by pair-session as a second defence.
RUN setcap cap_setuid+ep /usr/bin/newuidmap \
    && setcap cap_setgid+ep /usr/bin/newgidmap

# Durable state lives on the mounted volume, never in this layer (C8), so a
# relaunch loses no work and no transcript.
VOLUME /work
WORKDIR /work

ENV PAIR_APP_DIR=/run/secrets/github-app \
    PAIR_TOKEN_PATH=/run/dev-pair/gh-token \
    CLAUDEBOX_SHARE=/usr/share/dev-pair/claudebox

# PID 1 is a session multiplexer rather than a shell: the container's whole
# purpose is that sessions outlive the client that started them.
ENTRYPOINT ["/usr/bin/pair-session"]
