# dev-container.container — the Quadlet the HOST uses to run this pair's dev-container
# (the host's REFRESH verb swaps the image; the container is a cattle unit, all durable
# state on the two volumes).
#
# Install: copy to ~core/.config/containers/systemd/ on the host, `systemctl --user
# daemon-reload`, `systemctl --user start dev-container`. The image is CI-built and
# pulled by digest at refresh time (FR-WORK-5); :latest here is the development default.
[Unit]
Description=dev-pair dev-container (this pair's working half)

[Container]
Image=ghcr.io/oso-gato/dev-container:latest
ContainerName=dev-container
HostName=dev-container

# The public door (FR-SEC-1/2): key-only ssh (+ mosh UDP) on the host's public interface.
# Everything else rides the tailnet (the container joins it itself; Tailscale SSH is the
# keyless tailnet path).
PublishPort=4444:22
PublishPort=61001-62000:61001-62000/udp

# Durable state OUTSIDE the image (P11): home (work, credentials, transcripts) and the
# state volume (ssh host keys, tailscale identity).
Volume=devpair-home:/home/core
Volume=devpair-state:/var/lib/devpair

# Nested rootless podman (the agent layer runs its boxes inside).
AddDevice=/dev/fuse
# The tailnet device.
AddDevice=/dev/net/tun

# Runtime-only secrets (never a layer): the unattended tailnet-join key and the pair's
# GitHub App key. Provided by the host as podman secrets; absent ts-authkey -> the
# interactive browser join (one-time per state volume).
Secret=ts-authkey,type=mount,target=/run/secrets/ts-authkey,optional=true
Secret=gh_app_key,type=mount,target=/run/secrets/gh_app_key,optional=true

# The pair's own App identity (FR-WORK-6) — set per pair at deploy time.
# Environment=GH_APP_ID=
# Environment=GH_APP_INSTALLATION_ID=

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
